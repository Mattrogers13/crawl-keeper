{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // TODO: set to the extension's worker name (becomes <name>.<subdomain>.workers.dev).
  "name": "crawl-keeper",
  "compatibility_date": "2026-10-15",
  // Explicit so we don't depend on defaults: workers.dev serves production,
  // preview URLs serve PR builds.
  "workers_dev": true,
  "preview_urls": true,
  // Required by `wrangler preview` (PR preview builds); empty = same settings as production.
  "previews": {},
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  }
}
